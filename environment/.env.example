# environment/.env.example — danh sách TÊN biến cho môi trường test.
# CHỈ TÊN + MÔ TẢ, không bao giờ có giá trị thật (environment/README.md luật 1).
# Giá trị thật: environment/local/.env (không commit). make doctor đối chiếu file này.

# --- Môi trường + URL (pha P điền từ manifest / ENVIRONMENT.md §1–§2) ---
SPEC_ENV=                   # production | staging — khớp dòng `Môi trường:` của manifest
SPEC_URL_MAIN=              # URL điểm vào chính trên môi trường test — khớp `Điểm vào chính:`
# SPEC_URL_<BOUNDARY>=      # mỗi boundary/microservice một biến, tên viết hoa

# --- Tài khoản test theo vai (make accounts tạo — mỗi vai trong ma trận một cặp) ---
# SPEC_USER_<ROLE>=         # email tài khoản test, dạng spec+<role>@…
# SPEC_PW_<ROLE>=           # mật khẩu — sinh ngẫu nhiên, chỉ nằm ở local/.env

# --- Cách ly ---
SPEC_TENANT=                # tên/định danh tenant test (ENVIRONMENT.md §4)
SPEC_PREFIX=                # prefix dữ liệu, mặc định SPEC-r<N>-

# --- Tích hợp (chỉ khai biến sản phẩm thực dùng — xoá dòng thừa) ---
# SPEC_MAILBOX=             # hộp thư nhận notification test
# SPEC_PAYMENT_SANDBOX_KEY= # khoá sandbox thanh toán (QC cấp qua manifest)
# SPEC_SMS_SANDBOX=         # số/hộp nhận SMS test — staging chưa có sandbox thì TC SMS BLOCKED

# --- Mobile (chỉ khi có mobile-experience) ---
# SPEC_MOBILE_BUNDLE_ID=    # bundle id / package name — từ manifest / tài liệu stack
# SPEC_MOBILE_BUILD=        # đường dẫn bản build đã bàn giao (manifest)
